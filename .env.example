# --- Backend ---
NODE_ENV=development
PORT=3000

# SQLite for local dev. For PostgreSQL run `npm run db:postgres` (rewrites the
# provider in prisma/schema.prisma) and put a postgresql:// URL here.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Telegram bot token from @BotFather. Leave empty to run without a bot:
# initData validation and notifications are then disabled (dev only).
BOT_TOKEN=

# Allow a fake signed-in user when BOT_TOKEN is empty (development only).
DEV_FAKE_USER=1

# Public HTTPS address of this deployment (tunnel or hosting URL). Set it and
# the bot webhook registers itself on boot; leave empty locally.
PUBLIC_URL=

# Secret path segment for the bot webhook. Any long random string.
WEBHOOK_SECRET=change-me-too-at-least-8-chars

# Extra allowed origins, comma-separated. Not needed when the backend serves
# the frontend from the same address.
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ---
# Leave empty: the app calls the API on its own origin. Only set this if the API
# is hosted somewhere else.
VITE_API_URL=
