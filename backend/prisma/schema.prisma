// Switch `provider` to "postgresql" (and DATABASE_URL to a postgres:// URL)
// to run the same schema on PostgreSQL — no model changes needed.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(cuid())
  telegramId String   @unique
  firstName  String
  lastName   String?
  username   String?
  photoUrl   String?
  /// "author" | "category" — how events are coloured for this user
  colorPref  String   @default("category")
  createdAt  DateTime @default(now())

  memberships    Membership[]
  authoredEvents Event[]            @relation("EventAuthor")
  editedEvents   Event[]            @relation("EventEditor")
  participations EventParticipant[]
  createdTasks   Task[]             @relation("TaskAuthor")
  assignedTasks  Task[]             @relation("TaskAssignee")
  completedTasks Task[]             @relation("TaskCompleter")
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  timezone   String   @default("Europe/Moscow")
  createdAt  DateTime @default(now())

  members    Membership[]
  events     Event[]
  categories Category[]
  tasks      Task[]
}

/// Colour-coded label owned by a family, e.g. "Планы Ани" or "Семейные дела".
/// Kept as data rather than an enum so a family can rename, recolour and extend
/// the list without a code change.
model Category {
  id         String    @id @default(cuid())
  familyId   String
  name       String
  /// hex colour, e.g. "#4C6FFF"
  color      String
  sortOrder  Int       @default(0)
  /// Archived categories stay attached to old events but leave the pickers.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  events Event[]
  tasks  Task[]

  @@index([familyId])
}

model Membership {
  userId   String
  familyId String
  /// "owner" | "member"
  role     String   @default("member")
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([userId, familyId])
  @@index([familyId])
}

model Event {
  id              String    @id @default(cuid())
  familyId        String
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean   @default(false)
  /// Legacy label ("work" | "study" | "home" | "holiday" | "other"). Superseded
  /// by categoryId; kept for one release so the backfill has a source to read.
  category        String    @default("other")
  categoryId      String?
  color           String?
  authorId        String
  updatedById     String?
  /// e.g. "FREQ=WEEKLY;INTERVAL=1;UNTIL=2026-01-01T00:00:00.000Z"
  rrule           String?
  /// minutes before start to send a reminder; null = no reminder
  reminderMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  family       Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author       User               @relation("EventAuthor", fields: [authorId], references: [id])
  updatedBy    User?              @relation("EventEditor", fields: [updatedById], references: [id])
  categoryRef  Category?          @relation(fields: [categoryId], references: [id])
  participants EventParticipant[]
  exceptions   EventException[]
  reminders    ReminderLog[]

  @@index([familyId, startsAt])
}

/// A thing to do that has a deadline but no time slot — "pay the bill by the
/// 9th". Shows both in the to-do section and on its due date in the calendar.
model Task {
  id            String    @id @default(cuid())
  familyId      String
  title         String
  notes         String?
  /// Due day at UTC midnight; null means "someday, no deadline".
  dueDate       DateTime?
  categoryId    String?
  assigneeId    String?
  done          Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  /// "morning" | "dayBefore" | "weekBefore"; null = no reminder
  remindMode    String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category    Category?         @relation(fields: [categoryId], references: [id])
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User              @relation("TaskAuthor", fields: [createdById], references: [id])
  completedBy User?             @relation("TaskCompleter", fields: [completedById], references: [id])
  reminders   TaskReminderLog[]

  @@index([familyId, dueDate])
}

/// Makes task reminder delivery exactly-once across scheduler ticks and restarts.
model TaskReminderLog {
  id       String   @id @default(cuid())
  taskId   String
  remindAt DateTime
  sentAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, remindAt])
}

model EventParticipant {
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

/// One overridden (moved, retitled or cancelled) occurrence of a recurring event.
model EventException {
  id           String    @id @default(cuid())
  eventId      String
  originalDate DateTime
  cancelled    Boolean   @default(false)
  title        String?
  description  String?
  startsAt     DateTime?
  endsAt       DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalDate])
}

/// Makes reminder delivery idempotent across scheduler ticks and restarts.
model ReminderLog {
  id              String   @id @default(cuid())
  eventId         String
  occurrenceStart DateTime
  sentAt          DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceStart])
}
